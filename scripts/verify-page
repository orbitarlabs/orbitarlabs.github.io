#!/usr/bin/env python3
"""Prove that a served page is the reference file: same bytes, same pixels, same animation frames.

Usage:
  scripts/verify-page REFERENCE TARGET [options]
  scripts/verify-page REFERENCE --serve DIR [options]   # serves DIR with python3 -m http.server and tests it
  scripts/verify-page REFERENCE --self-test             # each check must catch an injected fault

REFERENCE is the owner's file. TARGET is an http(s) URL or a local file. --serve DIR starts
`python3 -m http.server` on DIR (next to the browser) and tests http://127.0.0.1:PORT/.

Every page load is a fresh tab in Chrome's deterministic mode (chrome-headless-shell,
--deterministic-mode, BeginFrameControl). Virtual time (Emulation.setVirtualTimePolicy) advances in
16.7 ms ticks and every frame is produced by HeadlessExperimental.beginFrame at frame time = virtual
time, so requestAnimationFrame, CSS animations/transitions and IntersectionObserver run on the same
clock on every side. 16.7 ms keeps every timestamp on Chrome's 100 us timer grid; with 1000/60 ms its
jittered timer coarsening (a random per-process secret) made the reference differ from itself.
Scrollbars are hidden in the capture (Emulation.setScrollbarsHidden); the HTTP cache and service
workers are bypassed.

The matrix: viewports desktop 1440x900 and mobile 390x844 (touch, device scale 1) x light and dark x
positions (the top, each top-level <section> scrolled to, and the top with a real mouse click on the
theme toggle at --click-at ms) x --times (ms after the first frame following load or scroll).
Dark: prefers-color-scheme is emulated as dark and the page's own toggle (#site-theme) is clicked once
in that fresh browser profile, so later loads take the theme from the page's localStorage, as for a
returning visitor. The reference is rendered twice, in independent browsers (the reference control),
then the target once. The verdict is PASS only if every check passes:

  bytes          every load's main-frame response, as Chrome received it: final URL, HTTP status 200,
                 Content-Type (--expect-content-type, http(s) only), sha256 of the body (Fetch
                 interception for http(s); the decoded document text for file:) equal to the reference
  sections       each side's top-level sections are --expect-sections
  scroll         each position is reached: scrollY is the section's top (or the bottom clamp), the
                 section intersects the viewport, right after the scroll and after the last frame
  captures       every capture decodes, has the viewport's size and is not one uniform colour
  motion         where a moving landmark (the orbital canvas) is at least half on screen, its pixels
                 change between every two consecutive captured times, on every side
  theme          data-theme is the scheme on every load; the click flips it and stores it
  control        reference vs reference: every frame identical
  frames         reference vs target: every frame identical

BeginFrameControl exists only in chrome-headless-shell on Linux, so on other systems (or without
--chrome) the script runs itself inside Docker: python:3.12-slim (pinned digest) with
chrome-headless-shell 158.0.8127.88 from Chrome for Testing (pinned sha256), built on first use.
Exit status 0 = PASS, 1 = FAIL, 2 = could not run.
"""
import argparse, base64, hashlib, http.server, json, multiprocessing, os, pathlib, select, shutil, signal, socket, \
    subprocess, sys, tempfile, threading, time, zlib

CHS_VERSION = "158.0.8127.88"
CHS_SHA256 = {
    "linux64": "63401333cc587645bfaeea7f0c90958b327d249251e23954a47f30112ca23d5b",
    "linux-arm64": "9f89b7ef6574e4bbf6ddda9f17f1fab5626e93d6f7d852653232d0d3554df975",
}
BASE_IMAGE = "python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b"
DOCKERFILE = f"""FROM {BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \\
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 \\
    libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libdbus-1-3 \\
    libexpat1 libx11-6 libxcb1 libxext6 fonts-dejavu-core fonts-liberation \\
 && rm -rf /var/lib/apt/lists/*
RUN set -e; case "$(uname -m)" in x86_64) p=linux64; s={CHS_SHA256['linux64']};; \\
      aarch64) p=linux-arm64; s={CHS_SHA256['linux-arm64']};; *) exit 1;; esac; \\
    curl -fsSL -o /tmp/c.zip https://storage.googleapis.com/chrome-for-testing-public/{CHS_VERSION}/$p/chrome-headless-shell-$p.zip; \\
    echo "$s  /tmp/c.zip" | sha256sum -c -; unzip -q /tmp/c.zip -d /opt; rm /tmp/c.zip; \\
    ln -s /opt/chrome-headless-shell-$p/chrome-headless-shell /usr/local/bin/chrome-headless-shell; \\
    chrome-headless-shell --version
"""

VIEWPORTS = {"desktop": (1440, 900, False), "mobile": (390, 844, True)}
TICK = 16.7  # ms: ~60 Hz, and on Chrome's 100 us timer grid, so its jittered timer coarsening has nothing to round
INITIAL_VIRTUAL_TIME = 1767225600  # fixed Date.now() origin (2026-01-01T00:00:00Z) on every side
DEFAULT_TIMES = "0,250,500,1000,2000,4000,8000,14000"  # 14 s: past the Getting started 12.5 s auto-advance
# The launch page v8's top-level sections, in order.
EXPECTED_SECTIONS = ("section 1 .hero,section 2 .stats,#introduction,#performance,#verification,#scalability,"
                     "#dataset,#architecture,#getting-started,section 10 .closing")
# Moving landmarks of the launch page: (rule, the share of the element that must be on screen for the rule).
# "every": changes between every two consecutive captured times: the orbital canvas rotates and shimmers with
#   every requestAnimationFrame; the engineering diagrams loop CSS animations and rAF memory tokens; the
#   Getting started explorer (whole, as its typing is at the top and its tab progress above) types, grows
#   its tab progress bar, and advances to the next tab at 12.5 s.
# "first": an entrance animation started by IntersectionObserver: changes between the first two captured times.
LANDMARKS = {"#orb-canvas": ("every", 0.5), "#engineering-motion": ("every", 0.5), "#start-explorer": ("every", 0.9),
             "#speed-chart": ("first", 0.5), "#memory-chart": ("first", 0.5), ".precision-visual": ("first", 0.5),
             "#scalability-graph": ("first", 0.5)}
CLICK = "top + theme click"
INJECT = os.environ.get("VERIFY_PAGE_INJECT", "")  # --self-test only: the fault to inject


class CouldNotRun(Exception):
    pass


def die(msg):
    print("verify-page: " + msg, file=sys.stderr)
    sys.exit(2)


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def is_url(s):
    return s.startswith("http://") or s.startswith("https://")


# ---------------------------------------------------------------- Docker re-exec

def run_in_docker(argv, paths, out_dir):
    if not shutil.which("docker"):
        die("needs chrome-headless-shell on Linux (--chrome) or Docker to run it in")
    tag = "verify-page:" + sha256_bytes(DOCKERFILE.encode())[:12]
    if subprocess.run(["docker", "image", "inspect", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        print(f"verify-page: building {tag} (once): {BASE_IMAGE} + chrome-headless-shell {CHS_VERSION}", file=sys.stderr)
        if subprocess.run(["docker", "build", "-q", "-t", tag, "-"], input=DOCKERFILE.encode()).returncode:
            die("docker build failed")
    script = os.path.abspath(__file__)
    mounts, seen = [], set()
    for p, mode in [(os.path.dirname(script), "ro")] + [(p, "ro") for p in paths] + [(out_dir, "rw")]:
        d = p if os.path.isdir(p) else os.path.dirname(p)
        if (d, mode) not in seen:
            seen.add((d, mode))
            mounts += ["-v", f"{d}:{d}:{mode}"]
    cmd = ["docker", "run", "--rm", "--init", "--shm-size=1g", "-e", "VERIFY_PAGE_IN_DOCKER=1", "-e", "HOME=/tmp",
           "--user", f"{os.getuid()}:{os.getgid()}", *mounts, tag, "python3", script, *argv,
           "--chrome", "/usr/local/bin/chrome-headless-shell"]
    sys.exit(subprocess.run(cmd).returncode)


# ---------------------------------------------------------------- CDP over --remote-debugging-pipe

class Chrome:
    def __init__(self, binary, flags=()):
        self.profile = tempfile.mkdtemp(prefix="verify-page-profile-")
        to_r, to_w = os.pipe()
        from_r, from_w = os.pipe()
        argv = [binary, "--remote-debugging-pipe", "--user-data-dir=" + self.profile, "--no-first-run",
                "--no-default-browser-check", "--deterministic-mode", "--disable-gpu", "--force-color-profile=srgb",
                "--font-render-hinting=none", "--disable-dev-shm-usage", "--mute-audio", *flags, "about:blank"]
        self.log = open(os.path.join(self.profile, "chrome.log"), "wb")
        self.pid = os.fork()
        if self.pid == 0:
            try:
                a, b = os.dup(to_r), os.dup(from_w)
                os.dup2(a, 3); os.dup2(b, 4)
                os.set_inheritable(3, True); os.set_inheritable(4, True)
                os.dup2(self.log.fileno(), 1); os.dup2(self.log.fileno(), 2)
                os.closerange(5, 1024)
                os.execv(binary, argv)
            finally:
                os._exit(127)
        os.close(to_r); os.close(from_w)
        self.w, self.r, self.buf, self.next_id = to_w, from_r, b"", 0
        self.events, self.replies, self.pages = [], {}, {}

    def _read(self, timeout):
        while b"\0" not in self.buf:
            if not select.select([self.r], [], [], timeout)[0]:
                raise CouldNotRun("no message from Chrome in %ss" % timeout)
            d = os.read(self.r, 1 << 22)
            if not d:
                raise CouldNotRun("Chrome closed the pipe")
            self.buf += d
        m, self.buf = self.buf.split(b"\0", 1)
        return json.loads(m)

    def _pump(self, timeout):
        m = self._read(timeout)
        if "id" in m:
            self.replies[m["id"]] = m
        elif m.get("method") == "Fetch.requestPaused" and m.get("sessionId") in self.pages:
            self.pages[m["sessionId"]].on_paused(m["params"])
        else:
            self.events.append(m)

    def post(self, method, params=None, session=None):
        self.next_id += 1
        msg = {"id": self.next_id, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        data = json.dumps(msg).encode() + b"\0"
        while data:
            data = data[os.write(self.w, data):]
        return self.next_id

    def result(self, mid, method="", timeout=120):
        while mid not in self.replies:
            self._pump(timeout)
        m = self.replies.pop(mid)
        if "error" in m:
            raise CouldNotRun(f"{method}: {m['error']}")
        return m["result"]

    def send(self, method, params=None, session=None, timeout=120):
        return self.result(self.post(method, params, session), method, timeout)

    def take(self, method, session):
        out = [e for e in self.events if e["method"] == method and e.get("sessionId") == session]
        self.events = [e for e in self.events if not (e["method"] == method and e.get("sessionId") == session)]
        return out

    def wait(self, method, session=None, timeout=120):
        while True:
            for i, e in enumerate(self.events):
                if e["method"] == method and (session is None or e.get("sessionId") == session):
                    return self.events.pop(i)
            self._pump(timeout)

    def close(self):
        try:
            self.send("Browser.close", timeout=10)
        except Exception:
            pass
        try:
            os.kill(self.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        os.waitpid(self.pid, 0)
        os.close(self.w); os.close(self.r); self.log.close()
        shutil.rmtree(self.profile, ignore_errors=True)


class Page:
    """One tab under virtual time; every frame is produced by beginFrame at the virtual clock."""

    def __init__(self, chrome, viewport, scheme, url):
        self.c, self.viewport = chrome, viewport
        w, h, mobile = VIEWPORTS[viewport]
        self.target = chrome.send("Target.createTarget", {"url": "about:blank", "width": w, "height": h,
                                                          "enableBeginFrameControl": True})["targetId"]
        self.s = chrome.send("Target.attachToTarget", {"targetId": self.target, "flatten": True})["sessionId"]
        chrome.pages[self.s] = self
        self.paused = []
        self.cmd("Page.enable")
        self.cmd("Network.enable")
        self.cmd("Network.setCacheDisabled", {"cacheDisabled": True})
        self.cmd("Network.setBypassServiceWorker", {"bypass": True})
        if is_url(url):
            self.cmd("Fetch.enable", {"patterns": [{"urlPattern": "*", "resourceType": "Document", "requestStage": "Response"}]})
        self.cmd("Emulation.setDeviceMetricsOverride", {"width": w, "height": h, "deviceScaleFactor": 1, "mobile": mobile,
                                                        "screenWidth": w, "screenHeight": h})
        self.cmd("Emulation.setScrollbarsHidden", {"hidden": True})
        if mobile:
            self.cmd("Emulation.setTouchEmulationEnabled", {"enabled": True, "maxTouchPoints": 5})
        self.cmd("Emulation.setEmulatedMedia", {"features": [{"name": "prefers-color-scheme", "value": scheme},
                                                             {"name": "prefers-reduced-motion", "value": "no-preference"}]})
        self.base = self.cmd("Emulation.setVirtualTimePolicy", {"policy": "pause", "initialVirtualTime": INITIAL_VIRTUAL_TIME})["virtualTimeTicksBase"]
        self.ticks, self.vt, self.first_png = 0, 0.0, None

    def cmd(self, method, params=None):
        return self.c.send(method, params, self.s)

    def js(self, expr):
        r = self.cmd("Runtime.evaluate", {"expression": expr, "returnByValue": True})
        if "exceptionDetails" in r:
            raise CouldNotRun("page script failed: " + json.dumps(r["exceptionDetails"])[:400])
        return r["result"].get("value")

    def on_paused(self, p):
        """A main-frame response held by Fetch interception: keep its status, headers and raw body."""
        headers = {h["name"].lower(): h["value"] for h in p.get("responseHeaders") or []}
        rec = {"url": p["request"]["url"], "status": p.get("responseStatusCode"), "content_type": headers.get("content-type"),
               "error": p.get("responseErrorReason")}
        if rec["status"] and not (300 <= rec["status"] < 400 and "location" in headers):
            b = self.cmd("Fetch.getResponseBody", {"requestId": p["requestId"]})
            rec["body"] = base64.b64decode(b["body"]) if b.get("base64Encoded") else b["body"].encode()
        self.paused.append(rec)
        self.cmd("Fetch.continueRequest", {"requestId": p["requestId"]})

    def tick(self, screenshot=False):
        self.ticks += 1
        target = round(self.ticks * TICK * 1000) / 1000
        self.cmd("Emulation.setVirtualTimePolicy", {"policy": "pauseIfNetworkFetchesPending", "budget": round(target - self.vt, 3)})
        self.c.wait("Emulation.virtualTimeBudgetExpired", self.s)
        self.vt = target
        # whole microseconds (+0.4 us so a conversion that truncates still lands on the intended one)
        p = {"frameTimeTicks": round((self.base + self.vt) * 1000) / 1000 + 0.0004, "interval": TICK}
        if screenshot:
            p["screenshot"] = {"format": "png"}
        r = self.cmd("HeadlessExperimental.beginFrame", p)
        if screenshot:
            if "screenshotData" not in r:
                raise CouldNotRun("beginFrame returned no screenshot")
            png = base64.b64decode(r["screenshotData"])
            if INJECT == "blank-frames":
                w, h, _ = VIEWPORTS[self.viewport]
                png = png_encode(w, h, b"\xff" * (w * h * 3))
            if INJECT == "reused-frames":
                self.first_png = self.first_png or png
                png = self.first_png
            return png

    def load(self, url, max_ticks=1200):
        """Navigate, run frames until the document is complete, and return what Chrome loaded."""
        self.paused = []
        nav = self.cmd("Page.navigate", {"url": url})
        rec = {"url": url, "nav_error": nav.get("errorText")}
        if nav.get("errorText"):
            return rec
        for _ in range(max_ticks):
            self.tick()
            if self.js("document.readyState") == "complete":
                break
        else:
            raise CouldNotRun(f"{url} did not finish loading in {max_ticks} frames of virtual time")
        docs = [e["params"] for e in self.c.take("Network.responseReceived", self.s)
                if e["params"].get("type") == "Document" and e["params"].get("frameId") == nav["frameId"]]
        if not docs:
            rec["nav_error"] = "no main-frame response seen"
            return rec
        resp = docs[-1]["response"]
        body = self.cmd("Network.getResponseBody", {"requestId": docs[-1]["requestId"]})
        text = base64.b64decode(body["body"]) if body.get("base64Encoded") else body["body"].encode()
        rec.update(final_url=resp["url"], status=resp.get("status"), mime=resp.get("mimeType"), text_sha=sha256_bytes(text),
                   location=self.js("location.href"))
        final = [r for r in self.paused if "body" in r]
        if is_url(url):
            if len(final) != 1:
                rec["nav_error"] = f"{len(final)} intercepted main-frame bodies"
                return rec
            rec.update(raw_sha=sha256_bytes(final[0]["body"]), raw_len=len(final[0]["body"]),
                       content_type=final[0]["content_type"], fetch_status=final[0]["status"], fetch_url=final[0]["url"])
        return rec

    def close(self):
        self.c.send("Target.closeTarget", {"targetId": self.target})
        self.c.pages.pop(self.s, None)
        self.c.events = [e for e in self.c.events if e.get("sessionId") != self.s]


SECTIONS = "[...document.querySelectorAll('section')].filter(s=>!s.parentElement.closest('section'))"
LABELS_JS = SECTIONS + ".map((s,i)=>s.id?'#'+s.id:'section '+(i+1)+' .'+(s.classList[0]||''))"
STATE_JS = """JSON.stringify({theme:document.documentElement.dataset.theme||null,
 stored:(()=>{try{return localStorage.getItem('orbitar-theme')}catch(e){return 'error: '+e.name}})(),
 protocol:location.protocol})"""


def geometry_js(index, scroll):
    """Scroll (optionally) to top-level section `index` (-1: the top); return the geometry to check."""
    go = ("scrollTo({top:0,behavior:'instant'})" if index < 0 else
          f"scrollTo({{top:{SECTIONS}[{index}].getBoundingClientRect().top+scrollY,behavior:'instant'}})")
    if not scroll or INJECT == "no-scroll":
        go = "0"
    marks = json.dumps(list(LANDMARKS))
    return f"""(()=>{{{go};const de=document.documentElement,s=({index}<0)?null:{SECTIONS}[{index}],r=s?s.getBoundingClientRect():null;
 const lm={{}};for(const q of {marks}){{const e=document.querySelector(q);if(!e)continue;const b=e.getBoundingClientRect();
  const x0=Math.max(0,Math.ceil(b.left)),y0=Math.max(0,Math.ceil(b.top)),x1=Math.min(innerWidth,Math.floor(b.right)),y1=Math.min(innerHeight,Math.floor(b.bottom));
  const area=b.width*b.height;lm[q]={{box:[x0,y0,x1,y1],visible:area>0&&x1>x0&&y1>y0?(x1-x0)*(y1-y0)/area:0}}}}
 return JSON.stringify({{scrollY:scrollY,max:de.scrollHeight-innerHeight,ih:innerHeight,
  top:r?r.top:null,bottom:r?r.bottom:null,abs:r?r.top+scrollY:0,landmarks:lm}})}})()"""


def geometry_ok(g, is_top):
    if is_top:
        return abs(g["scrollY"]) <= 0.5, f"scrollY {g['scrollY']:.0f}, expected 0"
    want = min(g["abs"], g["max"])
    clamped = g["abs"] > g["max"] + 1
    ok = (abs(g["scrollY"] - want) <= 1 and g["top"] < g["ih"] and g["bottom"] > 0
          and (abs(g["top"]) <= 1 or clamped))
    return ok, (f"scrollY {g['scrollY']:.0f}, expected {want:.0f}{' (bottom clamp)' if clamped else ''}; "
                f"section top {g['top']:.0f}, bottom {g['bottom']:.0f}, viewport height {g['ih']}")


def frame_ms(t):
    """The virtual time of the frame captured for a requested time t: the nearest 16.7 ms tick."""
    return round(round(t / TICK) * TICK, 1)


def render_side(binary, url, viewport, scheme, times, flags, positions, click_at):
    """All frames of one side for one viewport and scheme, in one fresh browser profile."""
    chrome = Chrome(binary, flags)
    try:
        loads, notes = [], {}
        if scheme == "dark":
            p = Page(chrome, viewport, scheme, url)
            loads.append(p.load(url))
            p.js("document.getElementById('site-theme').click()")
            p.tick()
            notes["after setup toggle"] = json.loads(p.js(STATE_JS))
            p.close()
        probe = Page(chrome, viewport, scheme, url)
        loads.append(probe.load(url))
        labels = probe.js(LABELS_JS) or []
        probe.close()
        frames, states = {}, {}
        want = {round(t / TICK): t for t in times}
        for pos in positions:  # the click run is last: it changes the stored theme
            if pos not in ("top", CLICK) and pos not in labels:
                states[pos] = {"missing": True}
                continue
            p = Page(chrome, viewport, scheme, url)
            loads.append(p.load(url))
            index = -1 if pos in ("top", CLICK) else labels.index(pos)
            st = {"theme": json.loads(p.js(STATE_JS)), "geo": json.loads(p.js(geometry_js(index, True)))}
            click_n = round(click_at / TICK) if pos == CLICK else None
            pending = []
            for n in range(round(max(times) / TICK) + 1):
                png = p.tick(screenshot=n in want)
                if png is not None:
                    frames[(pos, want[n])] = png
                if pending:  # the click was delivered with this frame
                    for mid in pending:
                        chrome.result(mid, "Input.dispatchMouseEvent")
                    pending = []
                    st["after click"] = json.loads(p.js(STATE_JS))
                if n == click_n:
                    st["before click"] = json.loads(p.js(STATE_JS))
                    c = p.js("JSON.stringify((b=>{const r=b.getBoundingClientRect();return [r.left+r.width/2,r.top+r.height/2,r.width,r.height]})(document.getElementById('site-theme')))")
                    x, y, bw, bh = json.loads(c)
                    st["click"] = [round(x), round(y), round(bw), round(bh)]
                    if bw and bh:  # a real mouse click at the toggle's centre
                        for kind, button, count in (("mouseMoved", "none", 0), ("mousePressed", "left", 1), ("mouseReleased", "left", 1)):
                            pending.append(chrome.post("Input.dispatchMouseEvent", {"type": kind, "x": x, "y": y, "button": button,
                                                                                     "clickCount": count}, p.s))
            st["geo_end"] = json.loads(p.js(geometry_js(index, False)))
            st["theme_end"] = json.loads(p.js(STATE_JS))
            states[pos] = st
            p.close()
        return {"labels": labels, "frames": frames, "states": states, "loads": loads, "notes": notes}
    finally:
        chrome.close()


# ---------------------------------------------------------------- PNG

def png_decode(data):
    """(width, height, channels, bytes) of an 8-bit non-interlaced RGB/RGBA PNG."""
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, w = 8, [], None
    while pos < len(data):
        n = int.from_bytes(data[pos:pos + 4], "big")
        kind, body = data[pos + 4:pos + 8], data[pos + 8:pos + 8 + n]
        if kind == b"IHDR":
            w, h = int.from_bytes(body[0:4], "big"), int.from_bytes(body[4:8], "big")
            depth, ctype, interlace = body[8], body[9], body[12]
            if depth != 8 or ctype not in (2, 6) or interlace:
                raise ValueError("unsupported PNG")
            ch = 3 if ctype == 2 else 4
        elif kind == b"IDAT":
            idat.append(body)
        pos += 12 + n
    if w is None:
        raise ValueError("PNG without IHDR")
    raw = zlib.decompress(b"".join(idat))
    stride = w * ch
    if len(raw) != h * (stride + 1):
        raise ValueError("PNG data has the wrong length")
    out = bytearray(h * stride)
    prev = bytearray(stride)
    for y in range(h):
        f = raw[y * (stride + 1)]
        line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if f == 1:
            for i in range(ch, stride):
                line[i] = (line[i] + line[i - ch]) & 255
        elif f == 2:
            line = bytearray((a + b) & 255 for a, b in zip(line, prev))
        elif f == 3:
            for i in range(stride):
                line[i] = (line[i] + (((line[i - ch] if i >= ch else 0) + prev[i]) >> 1)) & 255
        elif f == 4:
            for i in range(stride):
                a = line[i - ch] if i >= ch else 0
                b = prev[i]
                c = prev[i - ch] if i >= ch else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        elif f != 0:
            raise ValueError("bad PNG filter")
        out[y * stride:(y + 1) * stride] = line
        prev = line
    return w, h, ch, bytes(out)


def png_encode(w, h, rgb):
    def chunk(k, b):
        return len(b).to_bytes(4, "big") + k + b + zlib.crc32(k + b).to_bytes(4, "big")
    raw = b"".join(b"\0" + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", w.to_bytes(4, "big") + h.to_bytes(4, "big") + bytes([8, 2, 0, 0, 0]))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def pixel_diff(a, b, diff_path=None):
    """Differing pixels between two decoded images: (count, max channel delta, bounding box)."""
    w, h, ch, pa = a
    _, _, _, pb = b
    stride = w * ch
    count, maxd, box = 0, 0, None
    marks = None
    for y in range(h):
        ra, rb = pa[y * stride:(y + 1) * stride], pb[y * stride:(y + 1) * stride]
        if ra == rb:
            continue
        for x in range(w):
            p, q = ra[x * ch:x * ch + ch], rb[x * ch:x * ch + ch]
            if p != q:
                count += 1
                maxd = max(maxd, max(abs(i - j) for i, j in zip(p, q)))
                box = [x, y, x, y] if box is None else [min(box[0], x), min(box[1], y), max(box[2], x), max(box[3], y)]
                if diff_path:
                    marks = marks or {}
                    marks[(x, y)] = 1
    if count and diff_path:
        rgb = bytearray(w * h * 3)
        for i in range(w * h):
            g = (pa[i * ch] + pa[i * ch + 1] + pa[i * ch + 2]) // 12 + 170
            rgb[i * 3:i * 3 + 3] = b"\xff\x00\x00" if (i % w, i // w) in marks else bytes((g, g, g))
        with open(diff_path, "wb") as f:
            f.write(png_encode(w, h, bytes(rgb)))
    return count, maxd, box


def crop(img, box):
    w, h, ch, px = img
    x0, y0, x1, y1 = box
    return b"".join(px[(y * w + x0) * ch:(y * w + x1) * ch] for y in range(y0, y1))


def analyse_run(job):
    """Validate and compare all captures of one (viewport, scheme, position) run, on all three sides."""
    vp, scheme, pos, times, pngs, landmarks, out, tag = job
    w, h, _ = VIEWPORTS[vp]
    problems, rows, decoded = [], [], {}
    for side, seq in pngs.items():
        decoded[side] = []
        for t, png in zip(times, seq):
            try:
                img = png_decode(png)
            except Exception as e:
                problems.append(("captures", f"{side} {t} ms: {e}"))
                img = None
            if img:
                if (img[0], img[1]) != (w, h):
                    problems.append(("captures", f"{side} {t} ms: {img[0]}x{img[1]}, expected {w}x{h}"))
                elif img[3] == img[3][:img[2]] * (w * h):
                    problems.append(("captures", f"{side} {t} ms: one uniform colour"))
            decoded[side].append(img)
    steps = 0
    for side, marks in landmarks.items():
        for name, box in marks:
            for i in range(1, len(times) if LANDMARKS[name][0] == "every" else min(2, len(times))):
                a, b = decoded[side][i - 1], decoded[side][i]
                steps += 1
                if not (a and b) or crop(a, box) == crop(b, box):
                    problems.append(("motion", f"{side}: {name} {box} unchanged {frame_ms(times[i - 1])} -> {frame_ms(times[i])} ms"))
    for i, t in enumerate(times):
        r1, r2, tg = decoded["ref1"][i], decoded["ref2"][i], decoded["target"][i]
        res = {}
        for key, other in (("control", r2), ("frames", tg)):
            if r1 is None or other is None or (r1[0], r1[1]) != (other[0], other[1]):
                res[key] = (w * h, 255, None)
            elif pngs["ref1"][i] == (pngs["ref2"] if key == "control" else pngs["target"])[i] or r1[3] == other[3]:
                res[key] = (0, 0, None)
            else:
                res[key] = pixel_diff(r1, other, os.path.join(out, f"{tag}-{t}ms-{key}-diff.png"))
                for name, png in (("ref1", pngs["ref1"][i]), ("ref2", pngs["ref2"][i]), ("target", pngs["target"][i])):
                    open(os.path.join(out, f"{tag}-{t}ms-{name}.png"), "wb").write(png)
        rows.append((t, sha256_bytes(pngs["ref1"][i])[:8], res["control"], res["frames"]))
    return vp, scheme, pos, rows, problems, steps


# ---------------------------------------------------------------- the run

def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def check_loads(side, loads, ref_bytes, expect_ct, target_is_url):
    """Every main-frame load of one side against the reference bytes."""
    want, want_text = sha256_bytes(ref_bytes), sha256_bytes(ref_bytes.decode("utf-8").encode("utf-8"))
    bad = []
    for i, r in enumerate(loads):
        if r.get("nav_error"):
            bad.append(f"{side} load {i}: {r['url']}: {r['nav_error']}")
            continue
        if r["status"] != 200 and not (r["final_url"].startswith("file:") and r["status"] in (0, None)):
            bad.append(f"{side} load {i}: HTTP status {r['status']}")
        if r["text_sha"] != want_text:
            bad.append(f"{side} load {i}: document text sha256 {r['text_sha'][:12]}, reference {want_text[:12]}")
        if target_is_url:
            if r["raw_sha"] != want:
                bad.append(f"{side} load {i}: body sha256 {r['raw_sha'][:12]} ({r['raw_len']} bytes), reference {want[:12]} ({len(ref_bytes)} bytes)")
            if r["fetch_status"] != 200:
                bad.append(f"{side} load {i}: intercepted status {r['fetch_status']}")
            ct = (r["content_type"] or "").lower().replace(" ", "")
            if ct != expect_ct.lower().replace(" ", ""):
                bad.append(f"{side} load {i}: Content-Type {r['content_type']!r}, expected {expect_ct!r}")
    return bad


def main_run(a, out, target):
    ref_bytes = open(a.reference, "rb").read()
    version = subprocess.run([a.chrome, "--version"], capture_output=True, text=True).stdout.strip()
    flags = ["--no-sandbox"] if os.environ.get("VERIFY_PAGE_IN_DOCKER") or os.geteuid() == 0 else []
    times = [int(t) for t in a.times.split(",")]
    expected = [s for s in a.expect_sections.split(",") if s]
    ref_url = pathlib.Path(a.reference).as_uri()
    tgt_url = target if is_url(target) else pathlib.Path(target).as_uri()
    checks = {k: [] for k in ("bytes", "sections", "scroll", "captures", "motion", "theme", "control", "frames")}
    notes, jobs, loads_seen = [], [], {"reference": 0, "target": 0}
    target_info = None
    for vp in a.viewports.split(","):
        for scheme in a.schemes.split(","):
            t0 = time.time()
            positions = a.positions.split(",") if a.positions else ["top"] + (expected or [])
            if not a.positions and not expected:
                raise CouldNotRun("give --positions when --expect-sections is empty")
            if a.click_at >= 0 and CLICK not in positions:
                positions.append(CLICK)
            sides = {}
            for side, url in (("ref1", ref_url), ("ref2", ref_url), ("target", tgt_url)):
                sides[side] = render_side(a.chrome, url, vp, scheme, times, flags, positions, a.click_at)
            for side, d in sides.items():
                who = "reference" if side != "target" else "target"
                checks["bytes"] += check_loads(side, d["loads"], ref_bytes, a.expect_content_type, side == "target" and is_url(target))
                loads_seen[who] += len(d["loads"])
                if side == "target" and d["loads"] and not d["loads"][-1].get("nav_error"):
                    target_info = d["loads"][-1]
                if expected and d["labels"] != expected:
                    checks["sections"].append(f"{vp} {scheme} {side}: sections {d['labels']}, expected {expected}")
                for pos in positions:
                    st = d["states"][pos]
                    if st.get("missing"):
                        checks["sections"].append(f"{vp} {scheme} {side}: no section {pos}")
                        continue
                    for when, g in (("after scroll", st["geo"]), ("after last frame", st["geo_end"])):
                        ok, why = geometry_ok(g, pos in ("top", CLICK))
                        if not ok:
                            checks["scroll"].append(f"{vp} {scheme} {side} {pos} {when}: {why}")
                    themes = [st["theme"]["theme"]] + ([] if pos == CLICK else [st["theme_end"]["theme"]])
                    if any(t != scheme for t in themes):
                        checks["theme"].append(f"{vp} {scheme} {side} {pos}: data-theme {themes}")
                    if pos == CLICK:
                        flipped = "light" if scheme == "dark" else "dark"
                        after = st.get("after click", {})
                        if after.get("theme") != flipped or after.get("stored") != flipped or st["theme_end"]["theme"] != flipped:
                            checks["theme"].append(f"{vp} {scheme} {side} click: before {st.get('before click')}, after {after}, end {st['theme_end']}")
                ys = {}
                for pos in positions:
                    st = d["states"][pos]
                    if pos not in ("top", CLICK) and not st.get("missing"):
                        ys.setdefault(round(st["geo"]["scrollY"]), []).append((pos, st["geo"]))
                for y, ps in ys.items():
                    if len(ps) > 1 and not all(g["abs"] > g["max"] + 1 or abs(g["scrollY"] - g["max"]) <= 1 for _, g in ps):
                        checks["scroll"].append(f"{vp} {scheme} {side}: {[p for p, _ in ps]} all at scrollY {y}")
                notes.append(f"{vp} {scheme} {side}: {len(d['loads'])} loads, data-theme "
                             f"{sorted({str(d['states'][p].get('theme', {}).get('theme')) for p in positions})}"
                             + "".join(f"; {k} {v}" for k, v in d['notes'].items())
                             + (f"; click at {d['states'][CLICK].get('click')} → {d['states'][CLICK].get('after click')}" if CLICK in positions and not d['states'][CLICK].get('missing') else ""))
            for pos in positions:
                if any(sides[s]["states"][pos].get("missing") for s in sides):
                    continue
                pngs = {s: [sides[s]["frames"][(pos, t)] for t in times] for s in sides}
                if INJECT == "ref-control" and pos == positions[0]:
                    w, h, ch, px = png_decode(pngs["ref2"][0])
                    px = bytearray(px)
                    px[0] ^= 0x40
                    pngs["ref2"][0] = png_encode(w, h, bytes(px) if ch == 3 else bytes(b for i, b in enumerate(px) if i % 4 != 3))
                marks = {}
                for s in sides:
                    lm = sides[s]["states"][pos]["geo"]["landmarks"]
                    marks[s] = [(q, v["box"]) for q, v in lm.items() if v["visible"] >= LANDMARKS[q][1]]
                tag = f"{vp}-{scheme}-{pos.strip('#').replace(' + ', '-').replace(' ', '_').replace('.', '')}"
                jobs.append((vp, scheme, pos, times, pngs, marks, out, tag))
            print(f"{vp} {scheme}: {len(positions)} positions x {len(times)} times rendered on 3 sides, {time.time() - t0:.0f}s",
                  file=sys.stderr, flush=True)

    t0 = time.time()
    with multiprocessing.Pool(max(1, min(8, os.cpu_count() or 1))) as pool:
        results = pool.map(analyse_run, jobs)
    print(f"captures decoded, validated and compared in {time.time() - t0:.0f}s", file=sys.stderr, flush=True)
    rows, groups_moved, landmark_runs, landmark_checks = [], 0, 0, 0
    for (vp, scheme, pos, rr, problems, steps), job in zip(results, jobs):
        for kind, msg in problems:
            checks[kind].append(f"{vp} {scheme} {pos}: {msg}")
        landmark_runs += 1 if any(job[5].values()) else 0
        landmark_checks += steps
        hashes = {r[1] for r in rr}
        groups_moved += len(hashes) > 1
        for t, h, ctl, frm in rr:
            if ctl[0]:
                checks["control"].append(f"{vp} {scheme} {pos} {frame_ms(t)} ms: {ctl[0]} px (max channel Δ {ctl[1]}, box {ctl[2]})")
            if frm[0]:
                checks["frames"].append(f"{vp} {scheme} {pos} {frame_ms(t)} ms: {frm[0]} px (max channel Δ {frm[1]}, box {frm[2]})")
            rows.append((vp, scheme, pos, t, h, ctl, frm))

    w_total = {vp: VIEWPORTS[vp][0] * VIEWPORTS[vp][1] for vp in VIEWPORTS}
    table = ["| viewport | scheme | position | t (ms) | frame sha256 | ref vs ref: differing px | ref vs target: equal px | differing px | |",
             "|---|---|---|---:|---|---:|---:|---:|---|"]
    for vp, scheme, pos, t, h, ctl, frm in rows:
        vw, vh, _ = VIEWPORTS[vp]
        ok = not ctl[0] and not frm[0]
        table.append(f"| {vp} {vw}x{vh} | {scheme} | {pos} | {frame_ms(t)} | {h} | {ctl[0]:,} | {w_total[vp] - frm[0]:,} | {frm[0]:,} | {'equal' if ok else 'DIFFERS'} |")
    summary = {
        "bytes": f"{loads_seen['reference']} reference loads and {loads_seen['target']} target loads"
                 + (f"; target: {target_info.get('final_url')}, HTTP {target_info.get('status')}, Content-Type {target_info.get('content_type')!r}, "
                    f"body sha256 {target_info.get('raw_sha') or target_info.get('text_sha')}" if target_info else ""),
        "sections": f"{len(expected)} expected: {', '.join(expected)}" if expected else "not asserted (--expect-sections '')",
        "scroll": "each position's scrollY and section/viewport intersection, after the scroll and after the last frame",
        "captures": f"{3 * len(rows)} captures decoded; size and non-uniformity checked",
        "motion": f"moving landmarks ({', '.join(f'{q} {r} at {v:.0%}' for q, (r, v) in LANDMARKS.items())}) on screen in "
                  f"{landmark_runs} of {len(results)} runs, {landmark_checks} landmark steps checked; "
                  f"in {groups_moved} of {len(results)} runs the frame changes over time",
        "theme": "data-theme on every load" + ("; the click flips it and stores it" if a.click_at >= 0 else ""),
        "control": f"{len(rows)} reference frames vs an independent second rendering",
        "frames": f"{len(rows)} reference frames vs the target",
    }
    verdict = "PASS" if not any(checks.values()) else "FAIL"
    lines = ["## Checks"]
    for k, problems in checks.items():
        lines.append(f"{'FAIL' if problems else 'PASS'} {k}: {summary[k]}" + (f"; {len(problems)} problems" if problems else ""))
        lines += ["    " + p for p in problems[:40]] + (["    ..."] if len(problems) > 40 else [])
    report = [f"reference: {ref_url}", f"target:    {tgt_url}",
              f"browser:   {version}, --deterministic-mode, virtual time, one beginFrame per 16.7 ms tick, scrollbars hidden, device scale 1",
              "t = virtual ms since the first frame after load (top) or after the scroll; the frame nearest the asked time"
              + (f"; the click run clicks #site-theme right after the {frame_ms(a.click_at)} ms frame" if a.click_at >= 0 else ""),
              "", *lines, "", "## Loads and theme", *("    " + n for n in notes), "", "## Frames", *table, "", f"Overall: {verdict}"]
    text = "\n".join(report)
    open(os.path.join(out, "report.md"), "w").write(text + "\n")
    print(text)
    print(f"\nreport and any differing frames: {out}")
    return 0 if verdict == "PASS" else 1


# ---------------------------------------------------------------- --self-test

class SplitHandler(http.server.BaseHTTPRequestHandler):
    """Serves the reference to most clients, and a copy with an invisible comment to Chrome."""
    good = bad = b""

    def do_GET(self):
        body = self.bad if "Chrome" in (self.headers.get("User-Agent") or "") else self.good
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def self_test(a, out):
    ref = open(a.reference, "rb").read()
    work = tempfile.mkdtemp(prefix="self-test-", dir=out)
    one_px = os.path.join(work, "one-pixel")
    os.makedirs(one_px)
    marker = b"</body>"
    if marker not in ref:
        raise CouldNotRun("reference has no </body> to put the one-pixel overlay before")
    open(os.path.join(one_px, "index.html"), "wb").write(ref.replace(
        marker, b'<div style="position:fixed;left:0;top:0;width:1px;height:1px;background:#f0f;z-index:99999"></div>' + marker, 1))
    SplitHandler.good, SplitHandler.bad = ref, ref.replace(marker, b"<!-- not the owner's bytes -->" + marker, 1)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), SplitHandler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    split_url = f"http://127.0.0.1:{srv.server_address[1]}/"
    small = ["--viewports", "desktop", "--schemes", "light", "--times", "0,250,500", "--positions", "top,#architecture",
             "--click-at", "250", "--expect-sections", a.expect_sections, "--chrome", a.chrome]
    cases = [  # name, target args, injected fault, expected exit, a line the report must contain
        ("clean: reference vs itself", [a.reference], "", 0, "Overall: PASS"),
        ("reference control mismatch (one pixel of one reference frame)", [a.reference], "ref-control", 1, "FAIL control"),
        ("Chrome gets other bytes than other clients", [split_url], "", 1, "FAIL bytes"),
        ("scroll does nothing", [a.reference], "no-scroll", 1, "FAIL scroll"),
        ("captures are blank", [a.reference], "blank-frames", 1, "FAIL captures"),
        ("captures are reused across times", [a.reference], "reused-frames", 1, "FAIL motion"),
        ("target has a one-pixel overlay", ["--serve", one_px, "--expect-content-type", "text/html"], "", 1, "FAIL frames"),
    ]
    results = []
    for i, (name, target, fault, want_rc, want_line) in enumerate(cases):
        t0 = time.time()
        env = dict(os.environ, VERIFY_PAGE_INJECT=fault)
        r = subprocess.run([sys.executable, os.path.abspath(__file__), a.reference, *target, *small,
                            "--out", os.path.join(work, f"case{i}")], capture_output=True, text=True, env=env)
        caught = r.returncode == want_rc and want_line in r.stdout
        out_lines = r.stdout.splitlines()
        at = next((i for i, l in enumerate(out_lines) if l.startswith(want_line)), None)
        detail = "" if at is None else (out_lines[at].split(":")[0] if want_line.startswith("FAIL") else out_lines[at]) + (
            " — " + out_lines[at + 1].strip() if at + 1 < len(out_lines) and out_lines[at + 1].startswith("    ") else "")
        results.append((name, fault or "-", want_rc, r.returncode, caught, detail))
        print(f"{'ok  ' if caught else 'MISS'} {name}: exit {r.returncode} (want {want_rc}) {detail[:160]} [{time.time() - t0:.0f}s]", flush=True)
        if not caught:
            print(r.stdout[-3000:], r.stderr[-2000:], sep="\n")
    srv.shutdown()
    lines = ["| case | injected | expected exit | exit | caught | report line |", "|---|---|---:|---:|---|---|"]
    lines += [f"| {n} | {f} | {w} | {g} | {'yes' if c else 'NO'} | {d[:160].replace('|', '/')} |" for n, f, w, g, c, d in results]
    ok = all(r[4] for r in results)
    text = "\n".join(["## Self-test", *lines, "", f"Self-test: {'PASS' if ok else 'FAIL'}"])
    open(os.path.join(out, "self-test.md"), "w").write(text + "\n")
    print(text)
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("reference")
    ap.add_argument("target", nargs="?")
    ap.add_argument("--serve", metavar="DIR", help="serve DIR with python3 -m http.server and test it")
    ap.add_argument("--self-test", action="store_true", help="inject one fault per check and require that each is caught")
    ap.add_argument("--expect-content-type", default="text/html; charset=utf-8")
    ap.add_argument("--expect-sections", default=EXPECTED_SECTIONS, help="comma separated; '' to skip")
    ap.add_argument("--times", default=DEFAULT_TIMES, help="ms, comma separated")
    ap.add_argument("--click-at", type=int, default=1000, help="ms of the theme toggle click run; -1 for none")
    ap.add_argument("--viewports", default="desktop,mobile")
    ap.add_argument("--schemes", default="light,dark")
    ap.add_argument("--positions", default="", help="comma separated subset (top, section labels); default: all")
    ap.add_argument("--out", help="where the report and frames that differ are written (default: a new directory)")
    ap.add_argument("--chrome", help="chrome-headless-shell binary (Linux); without it the script runs in Docker")
    a = ap.parse_args()
    if not a.self_test and bool(a.target) == bool(a.serve):
        ap.error("give either TARGET or --serve DIR")
    a.reference = os.path.abspath(a.reference)
    if not os.path.isfile(a.reference):
        die(f"no reference file {a.reference}")
    if a.serve:
        a.serve = os.path.abspath(a.serve)
    if a.target and not is_url(a.target):
        a.target = os.path.abspath(a.target)
    out = os.path.abspath(a.out or os.path.join(os.path.expanduser("~"), ".cache", "verify-page", time.strftime("%Y%m%d-%H%M%S")))
    os.makedirs(out, exist_ok=True)

    if not a.chrome:
        argv = [a.reference] + ([a.target] if a.target else ["--serve", a.serve] if a.serve else [])
        argv += ["--expect-content-type", a.expect_content_type, "--expect-sections", a.expect_sections, "--times", a.times,
                 "--click-at", str(a.click_at), "--viewports", a.viewports, "--schemes", a.schemes, "--positions", a.positions,
                 "--out", out] + (["--self-test"] if a.self_test else [])
        run_in_docker(argv, [a.reference] + [p for p in (a.serve, a.target) if p and not is_url(p)], out)

    server = None
    try:
        if a.self_test:
            return self_test(a, out)
        target = a.target
        if a.serve:
            port = free_port()
            server = subprocess.Popen([sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1", "--directory", a.serve],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            target = f"http://127.0.0.1:{port}/"
            for _ in range(100):
                try:
                    socket.create_connection(("127.0.0.1", port), 0.2).close()
                    break
                except OSError:
                    time.sleep(0.1)
            print(f"serving {a.serve} with python3 -m http.server at {target}")
        return main_run(a, out, target)
    except CouldNotRun as e:
        print(f"verify-page: could not run: {e}", file=sys.stderr)
        return 2
    finally:
        if server:
            server.terminate()


if __name__ == "__main__":
    sys.exit(main())
