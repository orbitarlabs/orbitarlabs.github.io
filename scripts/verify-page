#!/usr/bin/env python3
"""Prove that a served page is the reference file: same bytes, same pixels, same animation frames.

Usage:
  scripts/verify-page REFERENCE TARGET [options]
  scripts/verify-page REFERENCE --serve DIR [options]   # serves DIR with python3 -m http.server and tests it

REFERENCE is the owner's file. TARGET is an http(s) URL or a local file. --serve DIR starts
`python3 -m http.server` on DIR (next to the browser) and tests http://127.0.0.1:PORT/.

1. Bytes: the target (curl --compressed, redirects followed) has the reference's sha256, and its
   Content-Type is --expect-content-type (default "text/html; charset=utf-8", what GitHub Pages sends).
2. Frames: the reference (file://) and the target are each loaded in Chrome's deterministic mode
   (chrome-headless-shell, --deterministic-mode, BeginFrameControl): virtual time
   (Emulation.setVirtualTimePolicy) advances in 16.7 ms ticks, and every frame is produced by
   HeadlessExperimental.beginFrame at frameTimeTicks = virtual time, so requestAnimationFrame,
   CSS animations/transitions and IntersectionObserver all run on the same clock on both sides.
   For each viewport (desktop 1440x900, mobile 390x844 with touch, device scale 1), scheme
   (light, dark) and position (the top, then scrolled to each top-level <section>), frames are
   captured at --times ms after the first frame following load (or the scroll), and compared pixel
   for pixel. The reference is rendered twice in independent browsers first, to show it is
   deterministic against itself; the table shows both comparisons.
   Dark: prefers-color-scheme is emulated as dark AND the page's own theme toggle (#site-theme) is
   clicked once in that browser profile, so the theme comes from the page's localStorage on the
   next loads, as for a returning visitor; light: a fresh profile with prefers-color-scheme light.

BeginFrameControl exists only in chrome-headless-shell on Linux, so on other systems (or without
--chrome) the script runs itself inside Docker: python:3.12-slim (pinned digest) with
chrome-headless-shell 158.0.8127.88 from Chrome for Testing (pinned sha256), built on first use.
Exit status 0 = PASS, 1 = FAIL, 2 = could not run.
"""
import argparse, base64, hashlib, json, os, select, shutil, signal, socket, subprocess, sys, tempfile, time, zlib

CHS_VERSION = "158.0.8127.88"
CHS_SHA256 = {
    "linux64": "63401333cc587645bfaeea7f0c90958b327d249251e23954a47f30112ca23d5b",
    "linux-arm64": "9f89b7ef6574e4bbf6ddda9f17f1fab5626e93d6f7d852653232d0d3554df975",
}
BASE_IMAGE = "python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b"
DOCKERFILE = f"""FROM {BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \\
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 \\
    libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 libdbus-1-3 \\
    libexpat1 libx11-6 libxcb1 libxext6 fonts-dejavu-core fonts-liberation \\
 && rm -rf /var/lib/apt/lists/*
RUN set -e; case "$(uname -m)" in x86_64) p=linux64; s={CHS_SHA256['linux64']};; \\
      aarch64) p=linux-arm64; s={CHS_SHA256['linux-arm64']};; *) exit 1;; esac; \\
    curl -fsSL -o /tmp/c.zip https://storage.googleapis.com/chrome-for-testing-public/{CHS_VERSION}/$p/chrome-headless-shell-$p.zip; \\
    echo "$s  /tmp/c.zip" | sha256sum -c -; unzip -q /tmp/c.zip -d /opt; rm /tmp/c.zip; \\
    ln -s /opt/chrome-headless-shell-$p/chrome-headless-shell /usr/local/bin/chrome-headless-shell; \\
    chrome-headless-shell --version
"""

VIEWPORTS = {"desktop": (1440, 900, False), "mobile": (390, 844, True)}
SCHEMES = ("light", "dark")
TICK = 16.7  # ms: ~60 Hz, and on Chrome's 100 us timer grid, so its jittered timer coarsening has nothing to round
INITIAL_VIRTUAL_TIME = 1767225600  # fixed Date.now() origin (2026-01-01T00:00:00Z) on every side


def die(msg):
    print("verify-page: " + msg, file=sys.stderr)
    sys.exit(2)


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def is_url(s):
    return s.startswith("http://") or s.startswith("https://")


# ---------------------------------------------------------------- Docker re-exec

def run_in_docker(argv, paths, out_dir):
    if not shutil.which("docker"):
        die("needs chrome-headless-shell on Linux (--chrome) or Docker to run it in")
    tag = "verify-page:" + sha256_bytes(DOCKERFILE.encode())[:12]
    if subprocess.run(["docker", "image", "inspect", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        print(f"verify-page: building {tag} (once): {BASE_IMAGE} + chrome-headless-shell {CHS_VERSION}", file=sys.stderr)
        if subprocess.run(["docker", "build", "-q", "-t", tag, "-"], input=DOCKERFILE.encode()).returncode:
            die("docker build failed")
    script = os.path.abspath(__file__)
    mounts, seen = [], set()
    for p, mode in [(os.path.dirname(script), "ro")] + [(p, "ro") for p in paths] + [(out_dir, "rw")]:
        d = p if os.path.isdir(p) else os.path.dirname(p)
        if (d, mode) not in seen:
            seen.add((d, mode))
            mounts += ["-v", f"{d}:{d}:{mode}"]
    cmd = ["docker", "run", "--rm", "--init", "--shm-size=1g", "-e", "VERIFY_PAGE_IN_DOCKER=1", "-e", "HOME=/tmp",
           "--user", f"{os.getuid()}:{os.getgid()}", *mounts, tag, "python3", script, *argv,
           "--chrome", "/usr/local/bin/chrome-headless-shell"]
    sys.exit(subprocess.run(cmd).returncode)


# ---------------------------------------------------------------- CDP over --remote-debugging-pipe

class Chrome:
    def __init__(self, binary, flags=()):
        self.profile = tempfile.mkdtemp(prefix="verify-page-profile-")
        to_r, to_w = os.pipe()
        from_r, from_w = os.pipe()
        argv = [binary, "--remote-debugging-pipe", "--user-data-dir=" + self.profile, "--no-first-run",
                "--no-default-browser-check", "--deterministic-mode", "--disable-gpu", "--force-color-profile=srgb",
                "--font-render-hinting=none", "--disable-dev-shm-usage", "--mute-audio", *flags, "about:blank"]
        self.log = open(os.path.join(self.profile, "chrome.log"), "wb")
        self.pid = os.fork()
        if self.pid == 0:
            try:
                a, b = os.dup(to_r), os.dup(from_w)
                os.dup2(a, 3); os.dup2(b, 4)
                os.set_inheritable(3, True); os.set_inheritable(4, True)
                os.dup2(self.log.fileno(), 1); os.dup2(self.log.fileno(), 2)
                os.closerange(5, 1024)
                os.execv(binary, argv)
            finally:
                os._exit(127)
        os.close(to_r); os.close(from_w)
        self.w, self.r, self.buf, self.next_id, self.events = to_w, from_r, b"", 0, []

    def _read(self, timeout):
        while b"\0" not in self.buf:
            if not select.select([self.r], [], [], timeout)[0]:
                raise TimeoutError("no message from Chrome in %ss" % timeout)
            d = os.read(self.r, 1 << 22)
            if not d:
                raise EOFError("Chrome closed the pipe (see %s)" % self.log.name)
            self.buf += d
        m, self.buf = self.buf.split(b"\0", 1)
        return json.loads(m)

    def send(self, method, params=None, session=None, timeout=120):
        self.next_id += 1
        msg = {"id": self.next_id, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        data = json.dumps(msg).encode() + b"\0"
        while data:
            data = data[os.write(self.w, data):]
        while True:
            m = self._read(timeout)
            if m.get("id") == self.next_id:
                if "error" in m:
                    raise RuntimeError(f"{method}: {m['error']}")
                return m["result"]
            if "method" in m:
                self.events.append(m)

    def wait(self, method, session=None, timeout=120):
        while True:
            for i, e in enumerate(self.events):
                if e["method"] == method and (session is None or e.get("sessionId") == session):
                    return self.events.pop(i)
            m = self._read(timeout)
            if "method" in m:
                self.events.append(m)

    def close(self):
        try:
            self.send("Browser.close", timeout=10)
        except Exception:
            pass
        try:
            os.kill(self.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        os.waitpid(self.pid, 0)
        os.close(self.w); os.close(self.r); self.log.close()
        shutil.rmtree(self.profile, ignore_errors=True)


class Page:
    """One tab under virtual time; every frame is produced by beginFrame at the virtual clock."""

    def __init__(self, chrome, viewport, scheme):
        self.c = chrome
        w, h, mobile = VIEWPORTS[viewport]
        self.target = chrome.send("Target.createTarget", {"url": "about:blank", "width": w, "height": h,
                                                          "enableBeginFrameControl": True})["targetId"]
        self.s = chrome.send("Target.attachToTarget", {"targetId": self.target, "flatten": True})["sessionId"]
        self.cmd("Page.enable")
        self.cmd("Emulation.setDeviceMetricsOverride", {"width": w, "height": h, "deviceScaleFactor": 1, "mobile": mobile,
                                                        "screenWidth": w, "screenHeight": h})
        if mobile:
            self.cmd("Emulation.setTouchEmulationEnabled", {"enabled": True, "maxTouchPoints": 5})
        self.cmd("Emulation.setEmulatedMedia", {"features": [{"name": "prefers-color-scheme", "value": scheme},
                                                             {"name": "prefers-reduced-motion", "value": "no-preference"}]})
        self.base = self.cmd("Emulation.setVirtualTimePolicy", {"policy": "pause", "initialVirtualTime": INITIAL_VIRTUAL_TIME})["virtualTimeTicksBase"]
        self.ticks = 0
        self.vt = 0.0

    def cmd(self, method, params=None):
        return self.c.send(method, params, self.s)

    def js(self, expr):
        r = self.cmd("Runtime.evaluate", {"expression": expr, "returnByValue": True})
        if "exceptionDetails" in r:
            raise RuntimeError("page script failed: " + json.dumps(r["exceptionDetails"])[:400])
        return r["result"].get("value")

    def tick(self, screenshot=False):
        self.ticks += 1
        target = round(self.ticks * TICK * 1000) / 1000
        self.cmd("Emulation.setVirtualTimePolicy", {"policy": "pauseIfNetworkFetchesPending", "budget": round(target - self.vt, 3)})
        self.c.wait("Emulation.virtualTimeBudgetExpired", self.s)
        self.vt = target
        # whole microseconds (+0.4 us so a conversion that truncates still lands on the intended one)
        p = {"frameTimeTicks": round((self.base + self.vt) * 1000) / 1000 + 0.0004, "interval": TICK}
        if screenshot:
            p["screenshot"] = {"format": "png"}
        r = self.cmd("HeadlessExperimental.beginFrame", p)
        if screenshot:
            if "screenshotData" not in r:
                raise RuntimeError("beginFrame returned no screenshot")
            return base64.b64decode(r["screenshotData"])

    def load(self, url, max_ticks=1200):
        self.cmd("Page.navigate", {"url": url})
        for _ in range(max_ticks):
            self.tick()
            if self.js("document.readyState") == "complete":
                return
        raise RuntimeError(f"{url} did not finish loading in {max_ticks} frames of virtual time")

    def close(self):
        self.c.send("Target.closeTarget", {"targetId": self.target})


SECTIONS_JS = """[...document.querySelectorAll('section')].filter(s=>!s.parentElement.closest('section'))
 .map((s,i)=>s.id?'#'+s.id:'section '+(i+1)+' .'+(s.classList[0]||''))"""
STATE_JS = """JSON.stringify({theme:document.documentElement.dataset.theme||null,
 stored:(()=>{try{return localStorage.getItem('orbitar-theme')}catch(e){return 'error: '+e.name}})(),
 protocol:location.protocol,scrollY:Math.round(scrollY),height:document.documentElement.scrollHeight})"""


def scroll_js(index):
    return f"""(()=>{{const s=[...document.querySelectorAll('section')].filter(s=>!s.parentElement.closest('section'))[{index}];
 scrollTo({{top:s.getBoundingClientRect().top+scrollY,behavior:'instant'}});return Math.round(scrollY)}})()"""


def frame_ms(t):
    """The virtual time of the frame captured for a requested time t: the nearest 16.7 ms tick."""
    return round(round(t / TICK) * TICK, 1)


def render_side(binary, url, viewport, scheme, times, flags, positions=None):
    """All frames of one side for one viewport and scheme, in one fresh browser profile."""
    chrome = Chrome(binary, flags)
    try:
        notes = {}
        if scheme == "dark":
            p = Page(chrome, viewport, scheme)
            p.load(url)
            p.js("document.getElementById('site-theme').click()")
            p.tick()
            notes["after-toggle"] = json.loads(p.js(STATE_JS))
            p.close()
        probe = Page(chrome, viewport, scheme)
        probe.load(url)
        labels = probe.js(SECTIONS_JS)
        probe.close()
        if positions is None:
            positions = ["top"] + labels
        frames, states = {}, {}
        last = max(times)
        for pi, pos in enumerate(positions):
            p = Page(chrome, viewport, scheme)
            p.load(url)
            y = p.js(scroll_js(labels.index(pos))) if pos != "top" else 0
            want = {round(t / TICK): t for t in times}
            for n in range(round(last / TICK) + 1):
                png = p.tick(screenshot=n in want)
                if png is not None:
                    frames[(pos, want[n])] = png
            states[pos] = dict(json.loads(p.js(STATE_JS)), y=y)
            p.close()
        return positions, frames, states, notes
    finally:
        chrome.close()


# ---------------------------------------------------------------- PNG

def png_decode(data):
    """(width, height, channels, bytes) of an 8-bit non-interlaced RGB/RGBA PNG."""
    assert data[:8] == b"\x89PNG\r\n\x1a\n"
    pos, idat = 8, []
    while pos < len(data):
        n = int.from_bytes(data[pos:pos + 4], "big")
        kind, body = data[pos + 4:pos + 8], data[pos + 8:pos + 8 + n]
        if kind == b"IHDR":
            w, h = int.from_bytes(body[0:4], "big"), int.from_bytes(body[4:8], "big")
            depth, ctype, interlace = body[8], body[9], body[12]
            if depth != 8 or ctype not in (2, 6) or interlace:
                raise ValueError("unsupported PNG")
            ch = 3 if ctype == 2 else 4
        elif kind == b"IDAT":
            idat.append(body)
        pos += 12 + n
    raw = zlib.decompress(b"".join(idat))
    stride = w * ch
    out = bytearray(h * stride)
    prev = bytearray(stride)
    for y in range(h):
        f = raw[y * (stride + 1)]
        line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if f == 1:
            for i in range(ch, stride):
                line[i] = (line[i] + line[i - ch]) & 255
        elif f == 2:
            line = bytearray((a + b) & 255 for a, b in zip(line, prev))
        elif f == 3:
            for i in range(stride):
                line[i] = (line[i] + (((line[i - ch] if i >= ch else 0) + prev[i]) >> 1)) & 255
        elif f == 4:
            for i in range(stride):
                a = line[i - ch] if i >= ch else 0
                b = prev[i]
                c = prev[i - ch] if i >= ch else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        out[y * stride:(y + 1) * stride] = line
        prev = line
    return w, h, ch, bytes(out)


def png_encode(w, h, rgb):
    def chunk(k, b):
        return len(b).to_bytes(4, "big") + k + b + zlib.crc32(k + b).to_bytes(4, "big")
    raw = b"".join(b"\0" + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", w.to_bytes(4, "big") + h.to_bytes(4, "big") + bytes([8, 2, 0, 0, 0]))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def compare(a, b, diff_path=None):
    """(equal pixels, differing pixels, max channel delta)."""
    if a == b:
        w, h = int.from_bytes(a[16:20], "big"), int.from_bytes(a[20:24], "big")
        return w * h, 0, 0
    wa, ha, ca, pa = png_decode(a)
    wb, hb, cb, pb = png_decode(b)
    if (wa, ha) != (wb, hb):
        return 0, max(wa * ha, wb * hb), 255
    if ca != cb:
        raise ValueError("PNG channel counts differ")
    n, diff, maxd = wa * ha, 0, 0
    marks = bytearray(n * 3)
    for i in range(n):
        x, y = pa[i * ca:i * ca + ca], pb[i * cb:i * cb + cb]
        if x != y:
            diff += 1
            maxd = max(maxd, max(abs(p - q) for p, q in zip(x, y)))
            marks[i * 3:i * 3 + 3] = b"\xff\x00\x00"
        else:
            g = (x[0] + x[1] + x[2]) // 12 + 170
            marks[i * 3:i * 3 + 3] = bytes((g, g, g))
    if diff and diff_path:
        with open(diff_path, "wb") as f:
            f.write(png_encode(wa, ha, bytes(marks)))
    return n - diff, diff, maxd


# ---------------------------------------------------------------- the checks

def check_bytes(ref, target, expect_ct):
    want = sha256_bytes(open(ref, "rb").read())
    lines, ok = [f"reference {os.path.basename(ref)} sha256 {want}"], True
    if is_url(target):
        with tempfile.TemporaryDirectory() as d:
            body = os.path.join(d, "body")
            r = subprocess.run(["curl", "--compressed", "-fsSL", "-o", body, "-w", "%{http_code} %{content_type} %{url_effective}",
                                target], capture_output=True, text=True)
            if r.returncode:
                return False, lines + [f"curl {target} failed: {r.stderr.strip()}"]
            code, rest = r.stdout.split(" ", 1)
            ct, final = rest.rsplit(" ", 1)
            got = sha256_bytes(open(body, "rb").read())
            size = os.path.getsize(body)
        lines.append(f"served    {final} (HTTP {code}) sha256 {got}, {size} bytes")
        ct_ok = ct.strip().lower().replace(" ", "") == expect_ct.lower().replace(" ", "")
        lines.append(f"Content-Type: {ct.strip()} ({'as expected' if ct_ok else 'expected ' + expect_ct})")
        ok = got == want and ct_ok
    else:
        got = sha256_bytes(open(target, "rb").read())
        lines.append(f"target    {target} sha256 {got}")
        ok = got == want
    lines.append("bytes: " + ("identical" if got == want else "DIFFERENT"))
    return ok, lines


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("reference")
    ap.add_argument("target", nargs="?")
    ap.add_argument("--serve", metavar="DIR", help="serve DIR with python3 -m http.server and test it")
    ap.add_argument("--expect-content-type", default="text/html; charset=utf-8")
    ap.add_argument("--times", default="0,250,500,1000,2000,4000,8000", help="ms, comma separated")
    ap.add_argument("--viewports", default="desktop,mobile")
    ap.add_argument("--schemes", default="light,dark")
    ap.add_argument("--out", help="where frames that differ, and the report, are written (default: a new directory)")
    ap.add_argument("--save-frames", action="store_true", help="also write every reference frame to --out")
    ap.add_argument("--chrome", help="chrome-headless-shell binary (Linux); without it the script runs in Docker")
    a = ap.parse_args()
    if bool(a.target) == bool(a.serve):
        ap.error("give either TARGET or --serve DIR")
    a.reference = os.path.abspath(a.reference)
    if not os.path.isfile(a.reference):
        die(f"no reference file {a.reference}")
    if a.serve:
        a.serve = os.path.abspath(a.serve)
    if a.target and not is_url(a.target):
        a.target = os.path.abspath(a.target)
    out = os.path.abspath(a.out or os.path.join(os.path.expanduser("~"), ".cache", "verify-page", time.strftime("%Y%m%d-%H%M%S")))
    os.makedirs(out, exist_ok=True)

    if not a.chrome:
        argv = [a.reference] + ([a.target] if a.target else ["--serve", a.serve])
        argv += ["--expect-content-type", a.expect_content_type, "--times", a.times, "--viewports", a.viewports,
                 "--schemes", a.schemes, "--out", out] + (["--save-frames"] if a.save_frames else [])
        run_in_docker(argv, [a.reference] + [p for p in (a.serve, a.target) if p and not is_url(p)], out)

    server = None
    try:
        target = a.target
        if a.serve:
            port = free_port()
            server = subprocess.Popen([sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1", "--directory", a.serve],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            target = f"http://127.0.0.1:{port}/"
            for _ in range(100):
                try:
                    socket.create_connection(("127.0.0.1", port), 0.2).close()
                    break
                except OSError:
                    time.sleep(0.1)
            print(f"serving {a.serve} with python3 -m http.server at {target}")
        version = subprocess.run([a.chrome, "--version"], capture_output=True, text=True).stdout.strip()
        flags = ["--no-sandbox"] if os.environ.get("VERIFY_PAGE_IN_DOCKER") or os.geteuid() == 0 else []
        bytes_ok, lines = check_bytes(a.reference, target, a.expect_content_type)
        report = ["## Bytes", *("    " + l for l in lines), ""]
        print("\n".join(report), flush=True)

        times = [int(t) for t in a.times.split(",")]
        ref_url = "file://" + a.reference
        tgt_url = target if is_url(target) else "file://" + target
        rows, all_ok, notes = [], True, []
        for vp in a.viewports.split(","):
            for scheme in a.schemes.split(","):
                t0 = time.time()
                pos, ref1, st1, n1 = render_side(a.chrome, ref_url, vp, scheme, times, flags)
                _, ref2, st2, n2 = render_side(a.chrome, ref_url, vp, scheme, times, flags, pos)
                _, tgt, st3, n3 = render_side(a.chrome, tgt_url, vp, scheme, times, flags, pos)
                for side, st, n in (("reference", st1, n1), ("target", st3, n3)):
                    themes = sorted({s["theme"] for s in st.values()})
                    stored = sorted({str(s["stored"]) for s in st.values()})
                    notes.append(f"{vp} {scheme} {side}: data-theme {themes}, localStorage orbitar-theme {stored}, "
                                 f"protocol {sorted({s['protocol'] for s in st.values()})}"
                                 + (f", after toggle {n['after-toggle']}" if n else ""))
                    if themes != [scheme]:
                        all_ok = False
                        notes.append(f"  FAIL: expected data-theme {scheme}")
                for p in pos:
                    for t in times:
                        k = (p, t)
                        tag = f"{vp}-{scheme}-{p.strip('#').replace(' ', '_').replace('.', '')}-{t}ms"
                        self_eq, self_diff, self_max = compare(ref1[k], ref2[k], os.path.join(out, tag + "-self-diff.png"))
                        eq, diff, mx = compare(ref1[k], tgt[k], os.path.join(out, tag + "-diff.png"))
                        if self_diff or diff:
                            for name, png in (("ref1", ref1[k]), ("ref2", ref2[k]), ("target", tgt[k])):
                                open(os.path.join(out, f"{tag}-{name}.png"), "wb").write(png)
                        ok = diff == 0
                        all_ok &= ok
                        if a.save_frames:
                            open(os.path.join(out, f"{tag}-ref1.png"), "wb").write(ref1[k])
                        rows.append((vp, scheme, f"{p} (y={st1[p]['y']})", frame_ms(t), sha256_bytes(ref1[k])[:8], self_eq, self_diff, eq, diff, mx, ok))
                print(f"{vp} {scheme}: {len(pos)} positions x {len(times)} times, {time.time() - t0:.0f}s", file=sys.stderr, flush=True)

        table = ["| viewport | scheme | position (scrollY) | t (ms) | frame sha256 | ref vs ref: equal px | differing px | ref vs target: equal px | differing px | |",
                 "|---|---|---|---:|---|---:|---:|---:|---:|---|"]
        for vp, scheme, p, t, h, se, sd, eq, d, mx, ok in rows:
            vw, vh, _ = VIEWPORTS[vp]
            table.append(f"| {vp} {vw}x{vh} | {scheme} | {p} | {t} | {h} | {se:,} | {sd:,} | {eq:,} | {d:,}" +
                         (f" (max channel Δ {mx})" if d else "") + f" | {'equal' if ok else 'DIFFERS'} |")
        self_bad = sum(1 for r in rows if r[6])
        groups = {}
        for r in rows:
            groups.setdefault(r[:3], set()).add(r[4])
        moving = sum(1 for g in groups.values() if len(g) > 1)
        verdict = "PASS" if bytes_ok and all_ok else "FAIL"
        report += ["## Frames", f"    browser: {version}, --deterministic-mode, virtual time, one beginFrame per 16.7 ms tick, device scale 1",
                   "    t = virtual ms since the first frame after load (top) or after the scroll; the frame nearest the asked time",
                   f"    reference: {ref_url}", f"    target:    {tgt_url}",
                   f"    {len(rows)} frames per side; reference vs itself: {len(rows) - self_bad} identical, {self_bad} differing;"
                   f" reference vs target: {sum(1 for r in rows if r[10])} identical, {sum(1 for r in rows if not r[10])} differing",
                   f"    animation: in {moving} of {len(groups)} (viewport, scheme, position) runs the frame changes between the captured times;"
                   f" {len({r[4] for r in rows})} distinct frames in all",
                   *("    " + n for n in notes), "", *table, "", f"Overall: {verdict}"]
        text = "\n".join(report)
        open(os.path.join(out, "report.md"), "w").write(text + "\n")
        print("\n".join(report[report.index("## Frames"):]))
        print(f"\nreport and any differing frames: {out}")
        return 0 if verdict == "PASS" else 1
    finally:
        if server:
            server.terminate()


if __name__ == "__main__":
    sys.exit(main())
